# ==============================================================================
# RentEase — Environment Variables Template
# ==============================================================================

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://rentease_user:rentease_secure_pass@localhost:5432/rentease_db?schema=public"

# Application Secrets & Session Management
# Min 32 characters long random secret used for session signature & hashing
SESSION_SECRET="super-secret-random-key-change-this-in-production-min-32-chars-long"
NODE_ENV="development"
PORT="3000"

# Application Public URL
APP_URL="http://localhost:3000"

# File & Attachment Storage Configuration (local | s3)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Optional Cloud Storage (S3 / MinIO - when STORAGE_DRIVER=s3)
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="rentease-uploads"
# S3_ACCESS_KEY="minioadmin"
# S3_SECRET_KEY="minioadmin"
